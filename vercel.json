{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/en/blog/mandare-un-pezzo-di-me-in-stratosfera",
      "destination": "/en/blog/send-a-piece-of-myself-to-the-stratosphere",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!sitemap.xml|robots.txt|.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "content-type", "value": "application/xml" },
        { "key": "cache-control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "content-type", "value": "text/plain" },
        { "key": "cache-control", "value": "public, max-age=86400, must-revalidate" }
      ]
    }
  ]
}
